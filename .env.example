# Copy to .env and fill in. Never commit .env: it holds secrets.
# Placeholders only: this file is safe to commit.

# --- Server ---
PORT=3000

# --- GitHub webhook ---
# The secret typed into GitHub > Settings > Webhooks > Secret. Leave empty to
# have one generated on first start and stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# Optional. Restrict Commit Doctor to ONE repository (owner/name). Events from
# any other repository are ignored. The dashboard can also set the repository.
GITHUB_REPO=

# How often (ms) to re-pull a webhook-tracked public repo through GitHub's API,
# so the dashboard stays current even when webhooks can't reach this server.
# Default 300000 (5 min); minimum 60000; 0 turns it off.
SYNC_INTERVAL_MS=300000

# --- Security ---
# Required for every write endpoint as "Authorization: Bearer <token>".
# If empty, writes are allowed only from the server machine itself, and never
# through a proxy or tunnel (ngrok, Render, etc). Set this on any public deploy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# 64-char hex key (32 bytes) used to encrypt GitHub tokens at rest (AES-256-GCM).
# Required only for polled (token-tracked, e.g. private) repos.
TOKEN_ENCRYPTION_KEY=

# --- Summary and prediction rules (these map to the study's design questions) ---
# IANA timezone that defines when a "day" starts and ends.
TIMEZONE=Asia/Manila
# Only save a daily summary when at least this many commits were made.
SUMMARY_MIN_COMMITS=1
# How many previous days form the baseline for "compared to recent days".
SUMMARY_COMPARISON_DAYS=7
# Rolling window (days) for the deadline prediction's commit rate and code churn.
CHURN_WINDOW_DAYS=21
# How often (ms) polled repos are checked. Minimum 60000.
POLL_INTERVAL_MS=180000

# --- Email (optional; notifications are off when SMTP_HOST is empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Storage ---
DB_PATH=./data/commitdoctor.db
